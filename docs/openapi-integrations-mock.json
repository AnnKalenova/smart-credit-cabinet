{
  "openapi": "3.1.0",
  "info": {
    "title": "Симулятор внешних систем (ЕГРЮЛ, ФНС, БКИ, АБС)",
    "description": "Симулятор внешних систем для кредитного конвейера.\n\nВоспроизводит в сокращённом виде контракты:\n  • ЕГРЮЛ/ЕГРИП (выписка о юрлице/ИП),\n  • ФНС «Прозрачный бизнес» (налоговые признаки, отчётность),\n  • Бюро кредитных историй (кредитный отчёт по согласию),\n  • АБС банка (открытие ссудного счёта и выдача).\nДанные синтетические и берутся из data/synthetic/companies.json.\n\nДля демонстрации отказоустойчивости любой сервис можно «уронить» или «замедлить»:\nPOST /_control/faults {\"service\": \"BKI\", \"mode\": \"down\", \"duration_seconds\": 120}\n",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/egrul/v1/entities/{inn}": {
      "get": {
        "tags": [
          "ЕГРЮЛ/ЕГРИП"
        ],
        "summary": "Выписка из реестра",
        "operationId": "egrul_egrul_v1_entities__inn__get",
        "parameters": [
          {
            "name": "inn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Inn"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/fns/v1/transparent-business/{inn}": {
      "get": {
        "tags": [
          "ФНС"
        ],
        "summary": "Сведения сервиса «Прозрачный бизнес»",
        "operationId": "fns_fns_v1_transparent_business__inn__get",
        "parameters": [
          {
            "name": "inn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Inn"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/bki/v1/credit-reports": {
      "post": {
        "tags": [
          "БКИ"
        ],
        "summary": "Кредитный отчёт по согласию субъекта",
        "operationId": "bki_bki_v1_credit_reports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BkiRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/abs/v1/loans": {
      "post": {
        "tags": [
          "АБС"
        ],
        "summary": "Открыть ссудный счёт и перечислить кредит (идемпотентно)",
        "operationId": "abs_disburse_abs_v1_loans_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DisburseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/_control/faults": {
      "get": {
        "tags": [
          "Управление симулятором"
        ],
        "summary": "Get Faults",
        "operationId": "get_faults__control_faults_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Управление симулятором"
        ],
        "summary": "Set Fault",
        "operationId": "set_fault__control_faults_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FaultIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BkiRequest": {
        "properties": {
          "inn": {
            "type": "string",
            "title": "Inn"
          },
          "consent_id": {
            "type": "string",
            "minLength": 1,
            "title": "Consent Id",
            "description": "ID подписанного согласия на запрос кредитной истории"
          },
          "purpose": {
            "type": "string",
            "title": "Purpose",
            "default": "loan_application"
          }
        },
        "type": "object",
        "required": [
          "inn",
          "consent_id"
        ],
        "title": "BkiRequest"
      },
      "DisburseRequest": {
        "properties": {
          "inn": {
            "type": "string",
            "title": "Inn"
          },
          "contract_number": {
            "type": "string",
            "title": "Contract Number"
          },
          "product_code": {
            "type": "string",
            "title": "Product Code"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "term_months": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Term Months"
          },
          "rate": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Rate"
          },
          "settlement_account": {
            "type": "string",
            "title": "Settlement Account"
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key"
          }
        },
        "type": "object",
        "required": [
          "inn",
          "contract_number",
          "product_code",
          "amount",
          "term_months",
          "rate",
          "settlement_account",
          "idempotency_key"
        ],
        "title": "DisburseRequest"
      },
      "FaultIn": {
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "EGRUL",
              "FNS",
              "BKI",
              "ABS"
            ],
            "title": "Service"
          },
          "mode": {
            "type": "string",
            "enum": [
              "ok",
              "down",
              "slow"
            ],
            "title": "Mode"
          },
          "duration_seconds": {
            "type": "integer",
            "maximum": 3600.0,
            "minimum": 10.0,
            "title": "Duration Seconds",
            "default": 120
          }
        },
        "type": "object",
        "required": [
          "service",
          "mode"
        ],
        "title": "FaultIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
