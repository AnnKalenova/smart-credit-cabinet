# Настройки публикации на сервере. Проще всего создать файл командой ./deploy/init.sh:
# она спросит домен и почту, а пароли сгенерирует сама. Вручную: cp deploy/.env.example deploy/.env
DOMAIN=credit.example.ru            # домен; его A-запись должна указывать на IP сервера
ACME_EMAIL=you@example.ru           # почта для писем Let's Encrypt о сертификате
JWT_SECRET=                         # случайная строка: openssl rand -hex 32
POSTGRES_PASSWORD=                  # пароль БД: openssl rand -hex 16 (задаётся при первом запуске)
CORS_ORIGINS=https://credit.example.ru
WEB_PORT=127.0.0.1:8080             # nginx — только для Caddy и самого сервера
DEMO_MODE=true                      # вход в один клик и коды подписи в окне — для жюри
ENVIRONMENT=cloud
