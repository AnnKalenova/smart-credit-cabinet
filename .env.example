# Пример настроек. Скопируйте в .env и при необходимости измените: cp .env.example .env
# Без .env всё запускается со значениями по умолчанию (они же указаны ниже).

# --- Порты на хосте
WEB_PORT=8080               # веб-интерфейс и Swagger (http://localhost:8080/api/docs)
API_PORT=8000               # прямой доступ к API (только localhost)
MOCK_PORT=8001              # симулятор внешних систем (только localhost)

# --- База данных PostgreSQL
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
POSTGRES_DB=credit

# --- Безопасность
JWT_SECRET=local-demo-secret-change-me-0123456789abcdef   # обязательно смените вне демо-стенда
JWT_TTL_MINUTES=480         # срок жизни токена входа
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Демо-режим
DEMO_MODE=true              # показывать демо-учётки и коды подписи в интерфейсе (SMS и почта не используются)
SEED_ON_START=true          # загружать синтетические данные при первом запуске

# --- Кредитная политика
DEFAULT_KEY_RATE=14.0       # ключевая ставка Банка России, %; дальше меняется риск-менеджером в интерфейсе
OFFER_VALID_DAYS=10         # срок действия предложения
MANUAL_REVIEW_SLA_HOURS=4   # срок ручного рассмотрения
SIGN_CODE_TTL_SECONDS=300   # срок действия кода подписи
MAX_UPLOAD_MB=10            # максимальный размер документа

# --- Конвейер и интеграции
PIPELINE_STAGE_DELAY_SECONDS=1.2       # пауза между этапами, чтобы в демо было видно движение заявки (в проде 0)
WORKER_POLL_INTERVAL_SECONDS=0.5
INTEGRATION_TIMEOUT_SECONDS=5          # таймаут вызова внешней системы
INTEGRATION_MAX_ATTEMPTS=5             # попыток до передачи заявки специалисту
INTEGRATION_BACKOFF_BASE_SECONDS=2     # экспоненциальная пауза между попытками: 2, 4, 8… c (не более 30)
MOCK_LATENCY_MIN_MS=150                # имитация задержки ответа внешних систем
MOCK_LATENCY_MAX_MS=600

# --- Логи
LOG_LEVEL=INFO
ENVIRONMENT=docker
